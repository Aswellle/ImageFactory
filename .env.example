# ImageForge environment configuration.
# Copy to .env and fill in. NEVER commit .env.

# --- Server ---
IF_SERVER_HOST=0.0.0.0
IF_SERVER_PORT=8080
IF_SERVER_MODE=debug

# --- Database ---
IF_DATABASE_HOST=localhost
IF_DATABASE_PORT=5432
IF_DATABASE_USER=imageforge
IF_DATABASE_PASSWORD=imageforge
IF_DATABASE_NAME=imageforge
IF_DATABASE_SSLMODE=disable

# --- Redis ---
IF_REDIS_HOST=localhost
IF_REDIS_PORT=6379
IF_REDIS_PASSWORD=
IF_REDIS_DB=0

# --- Auth ---
# CHANGE THIS in production. Used to sign JWTs.
IF_AUTH_JWT_SECRET=change-me-to-a-long-random-string
IF_AUTH_ACCESS_TOKEN_MINUTES=1440
IF_AUTH_BCRYPT_COST=12

# --- Storage (S3-compatible; MinIO for local dev, R2 for prod) ---
IF_STORAGE_PROVIDER=minio
IF_STORAGE_BUCKET=imageforge
IF_STORAGE_REGION=auto
# For MinIO local dev:
IF_STORAGE_ENDPOINT=http://localhost:9000
IF_STORAGE_ACCESS_KEY=minioadmin
IF_STORAGE_SECRET_KEY=minioadmin
# Optional: a CDN/public host used to serve assets. Leave empty to use presigned URLs.
IF_STORAGE_PUBLIC_HOST=

 # --- Sub2API (upstream AI gateway) ---
 # Base URL of the Sub2API proxy ImageForge calls for image generation.
 IF_SUB2API_BASE_URL=http://localhost:8090

# Backend credential to authenticate ImageForge -> Sub2API. NEVER expose to browsers.
IF_SUB2API_ADMIN_API_KEY=
# Sub2API upstream account id used for image generation.
IF_SUB2API_ACCOUNT_ID=
# Gemini (used for batch image generation)
IF_SUB2API_GEMINI_API_KEY=
IF_SUB2API_TIMEOUT_SECONDS=120

# --- Caddy / HTTPS (production) ---
# Public domain Caddy serves; set to enable auto-HTTPS + canonical redirects.
IF_CADDY_HOST=
# When true and Caddy terminates TLS, the backend emits https:// asset URLs.
IF_FORCE_HTTPS=false

# --- TZ (affects all timestamps: usage boundaries, logs, expiry) ---
TZ=UTC
